		"lint": "biome check",
		"prepare": "bun run build"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.48",
		"@libsql/client": "^0.17.2",
		"ai": "^6.0.141",
		"chalk": "^5.6.2",
		"clipboardy": "^5.3.1",
		"commander": "^14.0.3",
		"drizzle-orm": "^0.45.2",
		"log-update": "^7.2.0",
		"ora": "^9.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/bun": "^1.3.11",
		"@types/node": "^25.5.0",
		"drizzle-kit": "^0.31.10",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2"
	},
	"trustedDependencies": [
		"q-cli"
	]
}
