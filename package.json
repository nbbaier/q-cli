{
	"name": "q-cli",
	"version": "0.1.0",
	"type": "module",
	"bin": {
		"q": "./dist/index.mjs"
	},
	"files": [
		"dist",
		"migrations"
	],
	"scripts": {
		"build": "tsdown src/index.ts --platform node --format esm --outDir dist",
